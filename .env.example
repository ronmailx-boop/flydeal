# העתק קובץ זה ל-.env (cp .env.example .env) ומלא רק את מה שיש לך בפועל.
# השאר בלוק שלם ריק (USERNAME ריק) כדי לדלג על אותו חשבון בשקט.
# אזהרה: .env מכיל סיסמאות אמיתיות - הוא לעולם לא נכנס ל-git (ראה .gitignore),
# ואסור לשים את התיקייה הזו בתוך Google Drive/OneDrive/Dropbox מסונכרנים.

# --- בנק לאומי ---
LEUMI_USERNAME=
LEUMI_PASSWORD=

# --- ויזה מקס (המנפיק בפועל: Max) ---
MAX_USERNAME=
MAX_PASSWORD=

# --- ויזה כאל (המנפיק בפועל: Cal) ---
VISACAL_USERNAME=
VISACAL_PASSWORD=

# --- נקודת הניפוי המרוחק של Chromium (ברירת המחדל נכונה כמעט תמיד) ---
# CDP_URL=http://127.0.0.1:9222

# להוספת ספק נוסף בעתיד: יש לבדוק קודם באתר israeli-bank-scrapers
# (github.com/eshaham/israeli-bank-scrapers) מה בדיוק שדות ההתחברות הנדרשים
# עבור אותה חברה (לא כל הבנקים משתמשים ב-username+password בלבד), ואז להוסיף
# גם בלוק כאן וגם ערך תואם במערך ACCOUNTS בתוך fetch-and-report.js.
